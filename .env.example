# Скопируй в .env и заполни. .env в git не попадает.
# Cursor читает .env через envFile у stdio-серверов.
# Для remote (ha-mcp webhook, HACA) URL/токен продублируй в .cursor/mcp.json —
# подстановка ${env:NAME} в headers на Linux desktop часто не срабатывает.

# Home Assistant
HA_URL=http://192.168.1.19:8123
HA_TOKEN=

# HACS ha-mcp-integration (in-process). После перезагрузки HA:
# Settings → Devices → Home Assistant MCP Server → скопируй webhook URL целиком.
# Не запускай параллельно uvx ha-mcp — будет два клиента и путаница.
HA_MCP_URL=http://192.168.1.19:8123/api/webhook/

# HACA MCP: тот же long-lived token
HACA_MCP_URL=http://192.168.1.19:8123/api/haca_mcp

# MQTT Proxmox CT 101 (исторически 192.168.1.14). Z2M MCP ходит СЮДА, не в CT 126.
MQTT_HOST=192.168.1.14
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=zigbee2mqtt

# URL для zigbee2mqtt-mcp (alexpfau, MQTT bridge)
# mqtt://user:pass@192.168.1.14:1883
Z2M_MQTT_URL=mqtt://192.168.1.14:1883
Z2M_MQTT_BASE_TOPIC=zigbee2mqtt
MCP_TRANSPORT=stdio

# Z2M frontend в CT 126 — только для тебя в браузере, не для этого MCP
# Z2M_FRONTEND_URL=http://REPLACE_CT126_IP:8080
